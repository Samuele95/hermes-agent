<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's copy of main's shortcuts.xml: a static shortcut's targetPackage cannot take the applicationIdSuffix (D11). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_new_chat"
        android:shortcutShortLabel="@string/chat_new"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="com.nousresearch.hermes.android.NEW_CHAT"
            android:targetPackage="com.nousresearch.hermes.debug"
            android:targetClass="com.nousresearch.hermes.android.MainActivity" />
    </shortcut>
</shortcuts>
