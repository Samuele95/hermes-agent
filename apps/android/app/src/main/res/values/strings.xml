    <!-- The desktop's empty-chat lines for the neutral personality (apps/desktop/src/components/chat/intro-copy.jsonl). -->
    <string-array name="intro_lines">
        <item>Ask a question, paste an error, or point me at a repo. I can read code, run tools, and help you ship.</item>
        <item>Describe the task in your own words. I\'ll pick the right tools, explain my plan, and check in before risky steps.</item>
        <item>Drop a file path, a traceback, or a rough idea. I\'ll investigate, suggest next steps, and keep things reversible.</item>
        <item>Type a task, question, or snippet. I remember the session, cite my sources, and stop to ask when I\'m unsure.</item>
    </string-array>
