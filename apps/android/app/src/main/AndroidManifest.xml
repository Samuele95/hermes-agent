<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Providers and endpoints are reached over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which Wi-Fi network the phone is on, for the endpoint search the user starts (normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A running turn: dataSync foreground service, and its notification on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The optional always-on gateway (D23): a specialUse foreground service in its own process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:name=".HermesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Hermes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Text shared from other apps lands as an unsent draft (chat-42); no permission. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- "Ask Hermes" in quick settings opens a new chat; the system holds BIND_QUICK_SETTINGS_TILE, the app requests nothing. -->
        <service
            android:name=".entry.HermesTileService"
            android:exported="true"
            android:icon="@drawable/ic_new_chat"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".turn.TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".gateway.GatewayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":gateway">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on messaging gateway and scheduled jobs: keeps the user's own Hermes bot connected and runs the jobs the user scheduled, while the app is closed." />
        </service>
        <!-- Starts the gateway after a reboot, only when the user turned "start at boot" on. -->
        <receiver
            android:name=".gateway.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
